// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum MediaType {
  IMAGE
  VIDEO
}

// ─────────────────────────────────────────────
// Role
// ─────────────────────────────────────────────

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  users User[]
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  roleId       Int
  districtId   Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role     Role      @relation(fields: [roleId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// District
// ─────────────────────────────────────────────

model District {
  id             Int      @id @default(autoincrement())
  nameEn         String
  nameTa         String
  slug           String   @unique
  officeAddress  String?
  contactNumber  String?
  description_en String?
  description_ta String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  districtAdministrators DistrictAdministrator[]
  officBearers           OfficBearer[]
  whatsappGroup          WhatsappGroup?
  members                Member[]
  events                 Event[]
  news                   News[]
  gallery                Gallery[]
  users                  User[]
}

// ─────────────────────────────────────────────
// StateAdministrator
// ─────────────────────────────────────────────

model StateAdministrator {
  id              Int      @id @default(autoincrement())
  nameEn          String
  nameTa          String
  designationEn   String
  designationTa   String
  phone           String?
  photoUrl        String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// DistrictAdministrator
// ─────────────────────────────────────────────

model DistrictAdministrator {
  id            Int      @id @default(autoincrement())
  districtId    Int
  nameEn        String
  nameTa        String
  designationEn String
  designationTa String
  phone         String?
  photoUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// OfficBearer
// ─────────────────────────────────────────────

model OfficBearer {
  id         Int      @id @default(autoincrement())
  districtId Int
  nameEn     String
  nameTa     String
  roleEn     String
  roleTa     String
  phone      String?
  photoUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// Member
// ─────────────────────────────────────────────

model Member {
  id                 Int          @id @default(autoincrement())
  fullName           String
  mobile             String
  email              String?
  districtId         Int
  address            String?
  membershipCategory String       @default("General")
  status             MemberStatus @default(PENDING)
  registeredAt       DateTime     @default(now())
  approvedAt         DateTime?
  updatedAt          DateTime     @updatedAt

  district District @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// WhatsappGroup
// ─────────────────────────────────────────────

model WhatsappGroup {
  id         Int      @id @default(autoincrement())
  districtId Int      @unique
  groupName  String
  inviteLink String
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// Event
// ─────────────────────────────────────────────

model Event {
  id             Int      @id @default(autoincrement())
  districtId     Int?
  titleEn        String
  titleTa        String
  descriptionEn  String?
  descriptionTa  String?
  eventDate      DateTime
  location       String?
  imageUrl       String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  district District? @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// News
// ─────────────────────────────────────────────

model News {
  id          Int       @id @default(autoincrement())
  districtId  Int?
  titleEn     String
  titleTa     String
  contentEn   String
  contentTa   String
  imageUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  district District? @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// Gallery
// ─────────────────────────────────────────────

model Gallery {
  id          Int       @id @default(autoincrement())
  districtId  Int?
  titleEn     String?
  titleTa     String?
  mediaUrl    String
  mediaType   MediaType @default(IMAGE)
  caption     String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())

  district District? @relation(fields: [districtId], references: [id])
}

// ─────────────────────────────────────────────
// ContactDetail
// ─────────────────────────────────────────────

model ContactDetail {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  type      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// ─────────────────────────────────────────────
// Translation
// ─────────────────────────────────────────────

model Translation {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  valueEn   String
  valueTa   String
  section   String?
  updatedAt DateTime @updatedAt
}
