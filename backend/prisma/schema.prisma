// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PaymentStatus {
  PENDING
  PAYMENT_SUBMITTED
  VERIFIED
  REJECTED
}

// ─────────────────────────────────────────────
// Role
// ─────────────────────────────────────────────

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  users User[]
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  roleId       Int
  districtId   Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role          Role               @relation(fields: [roleId], references: [id])
  district      District?          @relation(fields: [districtId], references: [id])
  refreshTokens RefreshToken[]
  activityLogs  AdminActivityLog[]
}

// ─────────────────────────────────────────────
// District
// ─────────────────────────────────────────────

model District {
  id             Int      @id @default(autoincrement())
  nameEn         String
  nameTa         String
  slug           String   @unique
  officeAddress  String?
  contactNumber  String?
  description_en String?
  description_ta String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  districtAdministrators DistrictAdministrator[]
  officBearers           OfficBearer[]
  whatsappGroup          WhatsappGroup?
  members                Member[]
  events                 Event[]
  news                   News[]
  gallery                Gallery[]
  users                  User[]
  membershipApplications MembershipApplication[]
}

// ─────────────────────────────────────────────
// Membership Application, Payment, Documents, Settings
// ─────────────────────────────────────────────

model MembershipApplication {
  id                       Int          @id @default(autoincrement())
  serialNumber             String       @unique
  registrationDate         DateTime     @default(now())
  districtId               Int?
  applicantName            String
  age                      Int
  fatherName               String
  dob                      DateTime
  bloodGroup               String
  educationalQualification String
  aadhaarMasked            String?
  aadhaarEncrypted         String?
  aadhaarHash              String?
  experience               String
  shopName                 String
  shopAddress              String
  phone                    String
  referName                String?
  email                    String
  socialId                 String?
  alternateMobile          String?
  areaRtoNo                String
  termsAccepted            Boolean      @default(true)
  membershipStatus         MemberStatus @default(PENDING)
  rejectionReason          String?
  approvedAt               DateTime?
  reviewedById             Int?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  district  District?            @relation(fields: [districtId], references: [id])
  payments  MembershipPayment[]
  documents MembershipDocument[]

  @@index([membershipStatus, createdAt])
  @@index([phone])
  @@index([email])
  @@map("membership_applications")
}

model MembershipPayment {
  id                   Int           @id @default(autoincrement())
  applicationId        Int
  planType             String        @default("ANNUAL")
  amount               Int           @default(1200)
  upiTransactionId     String        @unique
  paymentScreenshotUrl String?
  paymentStatus        PaymentStatus @default(PAYMENT_SUBMITTED)
  rejectionReason      String?
  verifiedAt           DateTime?
  verifiedById         Int?
  verificationHistory  Json?
  submittedAt          DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([paymentStatus, submittedAt])
  @@map("membership_payments")
}

model MembershipDocument {
  id            Int      @id @default(autoincrement())
  applicationId Int
  docType       String
  fileUrl       String
  mimeType      String?
  fileSize      Int?
  createdAt     DateTime @default(now())

  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("membership_documents")
}

model MembershipSetting {
  id                Int      @id @default(autoincrement())
  associationNameEn String   @default("TAMILNADU MOBILE SALES AND SERVICE ASSOCIATION")
  associationNameTa String   @default("தமிழ்நாடு மொபைல் சேல்ஸ் மற்றும் சர்வீஸ் அசோசியேசன்")
  regNumber         String   @default("Regd : 23/2025")
  address           String   @default("234 Meenakshi Bazar, Scott Road, Madurai - 625001")
  helpline1         String   @default("+91 99447 73668")
  helpline2         String   @default("+91 97879 75782")
  annualFee         Int      @default(1200)
  halfYearlyFee     Int      @default(600)
  upiId             String   @default("tnmssa@upi")
  qrCodeUrl         String   @default("/tmssa-qr.png")
  termsText         String   @default("I agree to the terms and conditions of Tamilnadu Mobile Sales and Service Association (TNMSSA). Membership fee must be paid only to the official association account.")
  updatedAt         DateTime @updatedAt

  @@map("membership_settings")
}

// ─────────────────────────────────────────────
// RefreshToken (JWT Refresh Token Rotation)
// ─────────────────────────────────────────────

model RefreshToken {
  id                  Int       @id @default(autoincrement())
  tokenHash           String    @unique
  userId              Int
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// AdminActivityLog
// ─────────────────────────────────────────────

model AdminActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String
  entityId   Int?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType])
}

// ─────────────────────────────────────────────
// StateAdministrator
// ─────────────────────────────────────────────

model StateAdministrator {
  id              Int      @id @default(autoincrement())
  nameEn          String
  nameTa          String
  designationEn   String
  designationTa   String
  phone           String?
  photoUrl        String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// DistrictAdministrator
// ─────────────────────────────────────────────

model DistrictAdministrator {
  id            Int      @id @default(autoincrement())
  districtId    Int
  nameEn        String
  nameTa        String
  designationEn String
  designationTa String
  phone         String?
  photoUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])

  @@index([districtId, isActive])
}

// ─────────────────────────────────────────────
// OfficBearer
// ─────────────────────────────────────────────

model OfficBearer {
  id         Int      @id @default(autoincrement())
  districtId Int
  nameEn     String
  nameTa     String
  roleEn     String
  roleTa     String
  phone      String?
  photoUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])

  @@index([districtId, isActive])
}

// ─────────────────────────────────────────────
// Member
// ─────────────────────────────────────────────

model Member {
  id                 Int          @id @default(autoincrement())
  fullName           String
  mobile             String
  email              String?
  districtId         Int
  address            String?
  membershipCategory String       @default("General")
  status             MemberStatus @default(PENDING)
  registeredAt       DateTime     @default(now())
  approvedAt         DateTime?
  updatedAt          DateTime     @updatedAt

  district District @relation(fields: [districtId], references: [id])

  @@index([districtId, status])
}

// ─────────────────────────────────────────────
// WhatsappGroup
// ─────────────────────────────────────────────

model WhatsappGroup {
  id         Int      @id @default(autoincrement())
  districtId Int      @unique
  groupName  String
  inviteLink String
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])

  @@index([districtId, isActive])
}

// ─────────────────────────────────────────────
// Event
// ─────────────────────────────────────────────

model Event {
  id             Int      @id @default(autoincrement())
  districtId     Int?
  titleEn        String
  titleTa        String
  descriptionEn  String?
  descriptionTa  String?
  eventDate      DateTime
  eventTime      String?
  location       String?
  imageUrl       String?
  status         String   @default("UPCOMING")
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  district District? @relation(fields: [districtId], references: [id])

  @@index([isPublished, eventDate])
}

// ─────────────────────────────────────────────
// News
// ─────────────────────────────────────────────

model News {
  id          Int       @id @default(autoincrement())
  districtId  Int?
  titleEn     String
  titleTa     String
  contentEn   String
  contentTa   String
  imageUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  district District? @relation(fields: [districtId], references: [id])

  @@index([isPublished, publishedAt])
}

// ─────────────────────────────────────────────
// Gallery
// ─────────────────────────────────────────────

model Gallery {
  id          Int       @id @default(autoincrement())
  districtId  Int?
  titleEn     String?
  titleTa     String?
  description String?
  category    String    @default("General")
  album       String?
  mediaUrl    String
  publicId    String?
  mediaType   MediaType @default(IMAGE)
  caption     String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  district District? @relation(fields: [districtId], references: [id])

  @@index([isPublished, createdAt])
}

// ─────────────────────────────────────────────
// ContactDetail
// ─────────────────────────────────────────────

model ContactDetail {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  type      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// ─────────────────────────────────────────────
// Translation
// ─────────────────────────────────────────────

model Translation {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  valueEn   String
  valueTa   String
  section   String?
  updatedAt DateTime @updatedAt
}
